# ========================================
# Union Backend - 환경변수 설정
# 이 파일을 .env 로 복사 후 값을 수정하세요
# cp .env.example .env
# ========================================

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=dev          # dev | prod

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5433/union_integrated
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5433                        # docker-compose 외부 포트

# --- Server ---
SERVER_PORT=8080

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- CORS (prod용) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
